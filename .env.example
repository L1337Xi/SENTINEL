# SENTINEL API settings
SENTINEL_DATABASE_PATH=backend/data/sentinel.db
SENTINEL_MAX_PAGE_SIZE=100
SENTINEL_CORS_ORIGINS=http://127.0.0.1:5176,http://localhost:5176

# Local product presentation mode; this is not licence validation.
SENTINEL_EDITION=normal

# Persistent hash-only threat-intelligence cache (kept in backend/data by default)
SENTINEL_THREAT_INTEL_CACHE=data/threat_intel_cache.json
# Maximum distinct SHA-256 hashes queried against CIRCL per host scan (0 disables)
SENTINEL_CIRCL_MAX_LOOKUPS=20
